<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RunConvert</RootNamespace>
    <PackageId>RunConvert</PackageId>
    <Version>0.1.0</Version><!-- x-release-please-version -->
    <Authors>RunConvert</Authors>
    <Description>Official RunConvert SDK for .NET: convert files between 240+ formats.</Description>
    <PackageTags>runconvert;file converter;convert;pdf;video;image;api;sdk</PackageTags>
    <PackageProjectUrl>https://www.runconvert.com/docs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/runconvert/runconvert-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/runconvert/runconvert-dotnet/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="RunConvert.Tests" />
  </ItemGroup>
</Project>
